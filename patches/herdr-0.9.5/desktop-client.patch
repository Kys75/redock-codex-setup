diff --git a/src/client/local_file_actions.rs b/src/client/local_file_actions.rs
new file mode 100644
index 0000000..d2ae923
--- /dev/null
+++ b/src/client/local_file_actions.rs
@@ -0,0 +1,220 @@
+//! Multi-row file clicks use the existing local JSON API. Keep each row's
+//! revision check: a linear selection would include unrelated table columns.
+use std::io::{BufRead, BufReader, Read, Write};
+use std::time::{Duration, Instant};
+
+use interprocess::local_socket::traits::Stream as _;
+
+use crate::api::schema::{
+    Method, PaneSelectionReadParams, PaneTarget, PluginActionInvokeParams, PluginInvocationContext,
+    Request, ResponseResult,
+};
+
+#[derive(Debug)]
+pub(crate) struct LocalFileInvocation {
+    pub workspace_id: String,
+    pub tab_id: String,
+    pub pane_id: String,
+    pub action: &'static str,
+    pub selections: Vec<(PaneSelectionReadParams, String)>,
+}
+
+pub(super) fn invoke(invocation: LocalFileInvocation) -> Result<(), String> {
+    let path = crate::api::client::ApiClient::local().socket_path();
+    let identity = crate::ipc::socket_file_identity(&path).map_err(|e| e.to_string())?;
+    let deadline = Instant::now() + Duration::from_millis(1500);
+    // The JSON API accepts one request per connection. Check socket identity
+    // before sending each request so a restarted server cannot inherit checks.
+    invoke_with(invocation, |method| {
+        let remaining = deadline
+            .checked_duration_since(Instant::now())
+            .ok_or("文件路径核对超时，请重试。")?;
+        let stream = crate::ipc::connect_local_stream(&path).map_err(|e| e.to_string())?;
+        if crate::ipc::socket_file_identity(&path).map_err(|e| e.to_string())? != identity {
+            return Err("Herdr 后台已变化，请重新右键。".into());
+        }
+        let mut reader = BufReader::new(stream);
+        reader
+            .get_ref()
+            .set_send_timeout(Some(remaining))
+            .map_err(|e| e.to_string())?;
+        reader
+            .get_ref()
+            .set_recv_timeout(Some(remaining))
+            .map_err(|e| e.to_string())?;
+        let request = Request {
+            id: "client:local-file".into(),
+            method,
+        };
+        let mut bytes = serde_json::to_vec(&request).map_err(|e| e.to_string())?;
+        bytes.push(b'\n');
+        reader
+            .get_mut()
+            .write_all(&bytes)
+            .map_err(|e| e.to_string())?;
+        let mut reply = String::new();
+        (&mut reader)
+            .take(2 * 1024 * 1024)
+            .read_line(&mut reply)
+            .map_err(|e| e.to_string())?;
+        let value = serde_json::from_str(&reply).map_err(|e| e.to_string())?;
+        crate::api::client::parse_response_value(value)
+            .map(|r| r.result)
+            .map_err(|e| e.to_string())
+    })
+}
+
+fn invoke_with(
+    invocation: LocalFileInvocation,
+    mut rpc: impl FnMut(Method) -> Result<ResponseResult, String>,
+) -> Result<(), String> {
+    let changed = || "路径所在的窗格内容已变化，请重新右键。".to_owned();
+    if invocation.selections.is_empty() || invocation.selections.len() > 8 {
+        return Err(changed());
+    }
+    let target = PaneTarget {
+        pane_id: invocation.pane_id.clone(),
+    };
+    let ResponseResult::PaneInfo { pane: before } = rpc(Method::PaneGet(target.clone()))? else {
+        return Err(changed());
+    };
+    if before.pane_id != invocation.pane_id
+        || before.tab_id != invocation.tab_id
+        || before.workspace_id != invocation.workspace_id
+    {
+        return Err(changed());
+    }
+    let mut path = String::new();
+    for (selection, expected) in invocation.selections {
+        if selection.pane_id != invocation.pane_id || selection.content_revision.is_none() {
+            return Err(changed());
+        }
+        let ResponseResult::PaneSelection { pane_id, text } =
+            rpc(Method::PaneSelectionRead(selection))?
+        else {
+            return Err(changed());
+        };
+        if pane_id != invocation.pane_id || text != expected {
+            return Err(changed());
+        }
+        path.push_str(&text);
+    }
+    if path.len() > 8192 || path.chars().any(char::is_control) {
+        return Err(changed());
+    }
+    let ResponseResult::PaneInfo { pane: after } = rpc(Method::PaneGet(target))? else {
+        return Err(changed());
+    };
+    if before != after {
+        return Err(changed());
+    }
+    let context: PluginInvocationContext = serde_json::from_value(serde_json::json!({
+        "workspace_id": invocation.workspace_id, "tab_id": invocation.tab_id,
+        "focused_pane_id": invocation.pane_id, "selected_text": path,
+        "invocation_source": "local-file-mouse",
+    }))
+    .map_err(|e| e.to_string())?;
+    match rpc(Method::PluginActionInvoke(PluginActionInvokeParams {
+        plugin_id: Some("local.file-actions".into()),
+        action_id: invocation.action.into(),
+        context: Some(context),
+    }))? {
+        ResponseResult::PluginActionInvoked { .. } => Ok(()),
+        _ => Err("文件插件没有接受操作，请重试。".into()),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::api::schema::{PaneInfo, PaneTextPoint};
+
+    #[test]
+    fn wrapped_file_action_validates_every_fragment_and_pane_before_invoking() {
+        for failure in [
+            "none",
+            "changed-text",
+            "stale",
+            "wrong-pane",
+            "new-terminal",
+        ] {
+            let invocation = LocalFileInvocation {
+                workspace_id: "w1".into(),
+                tab_id: "w1:t1".into(),
+                pane_id: "w1:p1".into(),
+                action: "reveal",
+                selections: ["项目 空格/二层", "平面(1).pdf"]
+                    .into_iter()
+                    .enumerate()
+                    .map(|(row, text)| {
+                        (
+                            PaneSelectionReadParams {
+                                pane_id: "w1:p1".into(),
+                                anchor: PaneTextPoint {
+                                    row: row as u32,
+                                    col: 3,
+                                },
+                                cursor: PaneTextPoint {
+                                    row: row as u32,
+                                    col: 15,
+                                },
+                                content_revision: Some(4),
+                            },
+                            text.to_owned(),
+                        )
+                    })
+                    .collect(),
+            };
+            let mut info_reads = 0;
+            let mut selections = 0;
+            let mut invoked = false;
+            let result = invoke_with(invocation, |method| match method {
+                Method::PaneGet(_) => {
+                    info_reads += 1;
+                    let pane: PaneInfo = serde_json::from_value(serde_json::json!({
+                        "pane_id": "w1:p1", "workspace_id": "w1", "tab_id": "w1:t1", "terminal_id": if failure == "new-terminal" && info_reads == 2 { "new" } else { "original" },
+                        "focused": true, "agent_status": "idle", "revision": 4
+                    })).unwrap();
+                    Ok(ResponseResult::PaneInfo { pane })
+                }
+                Method::PaneSelectionRead(selection) => {
+                    assert_eq!(selection.content_revision, Some(4));
+                    selections += 1;
+                    if failure == "stale" && selections == 2 {
+                        return Err("stale_content".into());
+                    }
+                    Ok(ResponseResult::PaneSelection {
+                        pane_id: if failure == "wrong-pane" {
+                            "w2:p1"
+                        } else {
+                            "w1:p1"
+                        }
+                        .into(),
+                        text: if failure == "changed-text" {
+                            "unrelated.pdf"
+                        } else if selections == 1 {
+                            "项目 空格/二层"
+                        } else {
+                            "平面(1).pdf"
+                        }
+                        .into(),
+                    })
+                }
+                Method::PluginActionInvoke(params) => {
+                    invoked = true;
+                    assert_eq!(params.plugin_id.as_deref(), Some("local.file-actions"));
+                    assert_eq!(params.action_id, "reveal");
+                    let context = params.context.unwrap();
+                    assert_eq!(context.focused_pane_id.as_deref(), Some("w1:p1"));
+                    assert_eq!(
+                        context.selected_text.as_deref(),
+                        Some("项目 空格/二层平面(1).pdf")
+                    );
+                    Err("test-invoked".into())
+                }
+                _ => panic!("unexpected API request"),
+            });
+            assert_eq!(invoked, failure == "none", "{failure}: {result:?}");
+        }
+    }
+}
