+    /// A local terminal may represent an image-only Cmd+V as an empty paste.
+    /// The caller must establish that this client and endpoint share the clipboard.
+    #[cfg(any(unix, test))]
+    pub(crate) fn translate_local_codex_image_paste(
+        &self,
+        events: &mut [RawInputEvent],
+        allow_local_clipboard: bool,
+        can_paste_image: impl FnOnce(&str) -> bool,
+    ) {
+        if !allow_local_clipboard
+            || self.copy_mode.is_some()
+            || !matches!(events, [RawInputEvent::Paste(text)] if text.is_empty())
+        {
+            return;
+        }
+        let Some(crate::protocol::ClientClipboardImageTarget::Pane(pane_id)) =
+            self.clipboard_image_target()
+        else {
+            return;
+        };
+        let is_codex = self.snapshot.as_ref().is_some_and(|snapshot| {
+            snapshot
+                .agents
+                .iter()
+                .any(|agent| agent.pane_id == pane_id && agent.agent.as_deref() == Some("codex"))
+        });
+        if is_codex && can_paste_image(&pane_id) {
+            events[0] = RawInputEvent::Key(crate::input::TerminalKey::new(
+                KeyCode::Char('v'),
+                KeyModifiers::CONTROL,
+            ));
+        }
+    }
