+fn open_file_menu(state: &mut ClientShellState, col: u16) {
+    let mouse = file_mouse(state, col, MouseEventKind::Down(MouseButton::Right));
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(mouse)]);
+    assert!(
+        outcome.actions.is_empty(),
+        "opening the menu has no side effects"
+    );
+    state.compose(106, 24).unwrap();
+}
+
+fn click_file_action(state: &mut ClientShellState, label: &str) -> ClientShellInput {
+    let Some(ClientShellOverlay::ContextMenu(menu)) = state.overlay.as_ref() else {
+        panic!("expected file context menu");
+    };
+    let index = menu
+        .items()
+        .iter()
+        .position(|item| item.label == label)
+        .expect("file action must be available directly in the mouse menu");
+    let rect = state.hits.context_menu_rows[index].0;
+    state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: rect.x + 1,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
