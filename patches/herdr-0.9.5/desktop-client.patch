+#[test]
+fn mouse_file_hover_covers_both_table_path_segments_without_other_columns() {
+    for row in [0, 1] {
+        let mut state = wrapped_file_state();
+        let mut mouse = file_mouse(&state, if row == 0 { 15 } else { 4 }, MouseEventKind::Moved);
+        mouse.row += row;
+        state.handle_raw_events(vec![RawInputEvent::Mouse(mouse)]);
+        let regions = &state.link_hover.as_ref().expect("full path hover").regions;
+        assert_eq!(regions.len(), 2);
+        assert_eq!(
+            (regions[0].row, regions[0].start_col, regions[0].end_col),
+            (0, 10, 30)
+        );
+        assert_eq!(
+            (regions[1].row, regions[1].start_col, regions[1].end_col),
+            (1, 2, 14)
+        );
+    }
+}
