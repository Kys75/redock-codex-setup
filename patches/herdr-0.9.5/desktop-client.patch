+    let mouse = file_mouse(&state, 10, MouseEventKind::Moved);
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(mouse)]);
+    assert!(
+        outcome.actions.is_empty(),
+        "hover must not call a plugin or server"
+    );
+    let frame = state.compose(106, 24).unwrap();
+    let pane = &state.hits.panes[0];
+    let underlined = |col: u16| {
+        frame.cells[usize::from(pane.inner_rect.y) * usize::from(frame.width)
+            + usize::from(pane.inner_rect.x + col)]
+        .modifier
+            & Modifier::UNDERLINED.bits()
+            != 0
+    };
+    assert!(underlined(4));
+    assert!(
+        underlined(10),
+        "wide-cell spacer belongs to the Chinese filename"
+    );
+    assert!(!underlined(3));
+    assert!(!underlined(16));
+    let moved = file_mouse(&state, 12, MouseEventKind::Moved);
+    let repeated = state.handle_raw_events(vec![RawInputEvent::Mouse(moved)]);
+    assert!(
+        !repeated.repaint,
+        "moving within the same path should reuse its underline"
+    );
+    assert!(repeated.actions.is_empty());
