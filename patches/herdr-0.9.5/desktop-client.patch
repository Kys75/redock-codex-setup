+fn local_codex_paste_state() -> ClientShellState {
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+    let mut projected = snapshot();
+    projected.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: None,
+        agent: Some("codex".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: true,
+    });
+    state.set_snapshot(Box::new(projected));
+    state
+}
+
+#[test]
+fn local_codex_image_paste_reaches_pane_as_native_ctrl_v() {
+    let mut state = local_codex_paste_state();
+    let mut events = crate::raw_input::parse_framed_input(b"\x1b[200~\x1b[201~");
+    state.translate_local_codex_image_paste(&mut events, true, |pane_id| {
+        assert_eq!(pane_id, "pane_1");
+        true
+    });
+    assert!(matches!(&events[..], [RawInputEvent::Key(key)]
+        if key.code == KeyCode::Char('v') && key.modifiers == KeyModifiers::CONTROL));
+    let converted = state.handle_raw_events(events);
+    let native = state.handle_raw_events(crate::raw_input::parse_framed_input(b"\x16"));
+    assert_eq!(converted.requests, native.requests);
+    assert!(!converted.requests.is_empty());
+}
+
+#[test]
+fn local_codex_image_paste_preserves_text_ctrl_v_and_empty_clipboard() {
+    let state = local_codex_paste_state();
+    for bytes in [b"\x1b[200~hello\nworld\x1b[201~".as_slice(), b"\x16"] {
+        let mut events = crate::raw_input::parse_framed_input(bytes);
+        let before = format!("{events:?}");
+        state.translate_local_codex_image_paste(&mut events, true, |_| {
+            panic!("unexpected clipboard read")
+        });
+        assert_eq!(format!("{events:?}"), before);
+    }
+    let mut events = vec![RawInputEvent::Paste(String::new())];
+    state.translate_local_codex_image_paste(&mut events, true, |_| false);
+    assert!(matches!(&events[..], [RawInputEvent::Paste(text)] if text.is_empty()));
+}
+
+#[test]
+fn local_codex_image_paste_does_not_read_clipboard_for_other_targets() {
+    for case in [
+        "disabled-or-remote",
+        "shell",
+        "other-agent",
+        "other-pane",
+        "prefix",
+        "overlay",
+        "popup",
+        "pending",
+    ] {
+        let mut state = local_codex_paste_state();
+        match case {
+            "shell" => state.set_snapshot(Box::new(snapshot())),
+            "other-agent" => state.snapshot.as_mut().unwrap().agents[0].agent = Some("pi".into()),
+            "other-pane" => {
+                state.snapshot.as_mut().unwrap().focused_pane_id = Some("pane_2".into())
+            }
+            "prefix" => state.mode = ClientShellMode::Prefix,
+            "overlay" => state.overlay = Some(ClientShellOverlay::Onboarding),
+            "popup" => state.set_pane_surface(surface_with_popup()),
+            "pending" => state.popup_pending = true,
+            _ => {}
+        }
+        let mut events = vec![RawInputEvent::Paste(String::new())];
+        state.translate_local_codex_image_paste(&mut events, case != "disabled-or-remote", |_| {
+            panic!("unexpected clipboard read for {case}")
+        });
+        assert!(
+            matches!(&events[..], [RawInputEvent::Paste(text)] if text.is_empty()),
+            "{case}"
+        );
+    }
+}
