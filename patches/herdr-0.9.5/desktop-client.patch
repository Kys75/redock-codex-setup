+fn file_state(text: &str) -> ClientShellState {
+    let mut config = Config::default();
+    for (key, action) in [("prefix+f", "open"), ("prefix+d", "reveal")] {
+        config
+            .keys
+            .command
+            .push(crate::config::CommandKeybindConfig {
+                key: crate::config::BindingConfig::one(key),
+                command: format!("local.file-actions.{action}"),
+                action_type: crate::config::CommandKeybindType::PluginAction,
+                ..Default::default()
+            });
+    }
+    let commands = config
+        .keybinds()
+        .custom_commands
+        .iter()
+        .enumerate()
+        .map(|(i, binding)| crate::protocol::ClientShellCommand {
+            command_id: format!("cmd_file_{i}"),
+            binding_label: binding.label.clone(),
+            binding_labels: binding.bindings.labels(),
+            action: crate::protocol::ClientShellCommandAction::PluginAction,
+            description: binding.description.clone(),
+        })
+        .collect();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    let mut snap = snapshot();
+    snap.commands = commands;
+    state.set_snapshot(Box::new(snap));
+    state.set_endpoint_methods(Some(vec!["command.invoke".into()]));
+    let mut next = surface();
+    let buffer = Buffer::with_lines([text, ""]);
+    next.frame = FrameData::from_ratatui_buffer(&buffer, None);
+    next.panes[0].inner_rect.width = next.frame.width;
+    next.panes[0].rect.width = next.frame.width;
+    state.set_pane_surface(next);
+    state.compose(106, 24).unwrap();
+    state
+}
+
+fn file_mouse(state: &ClientShellState, col: u16, kind: MouseEventKind) -> MouseEvent {
+    let pane = &state.hits.panes[0];
+    MouseEvent {
+        kind,
+        column: pane.inner_rect.x + col,
+        row: pane.inner_rect.y,
+        modifiers: KeyModifiers::empty(),
+    }
+}
+
+fn wrapped_file_state() -> ClientShellState {
+    use ratatui::text::{Line, Span};
+    let mut state = file_state("placeholder");
+    let path_style = Style::default().fg(ratatui::style::Color::Green);
+    let lines = vec![
+        Line::from(vec![
+            Span::raw("drawings ("),
+            Span::styled("0701 项目/建筑图/二层", path_style),
+            Span::raw("    DWG    other column"),
+        ]),
+        Line::from(vec![
+            Span::raw("  "),
+            Span::styled("平面图(1).dwg", path_style),
+            Span::raw(")    unrelated text"),
+        ]),
+    ];
+    let buffer = Buffer::with_lines(lines);
+    let mut frame = surface();
+    frame.frame = FrameData::from_ratatui_buffer(&buffer, None);
+    frame.panes[0].inner_rect.width = frame.frame.width;
+    frame.panes[0].rect.width = frame.frame.width;
+    state.set_pane_surface(frame);
+    state.compose(106, 24).unwrap();
+    state
+}
