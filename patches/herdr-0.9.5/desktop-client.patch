+/// Snapshot agent labels can survive Ctrl+Z. Confirm the actual foreground job
+/// before turning an otherwise empty desktop paste into a control key.
+#[cfg(unix)]
+pub(super) fn local_codex_is_foreground(pane_id: &str) -> bool {
+    use crate::api::client::{parse_response_value, ApiClient};
+    use crate::api::schema::{Method, PaneProcessInfoParams, Request, ResponseResult};
+
+    let request = Request {
+        id: "client:local-image-paste".into(),
+        method: Method::PaneProcessInfo(PaneProcessInfoParams {
+            pane_id: Some(pane_id.to_owned()),
+        }),
+    };
+    let Ok(response) = ApiClient::local()
+        .request_value_with_timeout(&request, std::time::Duration::from_millis(300))
+        .and_then(parse_response_value)
+    else {
+        return false;
+    };
+    let ResponseResult::PaneProcessInfo { process_info } = response.result else {
+        return false;
+    };
+    foreground_is_codex(pane_id, process_info)
+}
+
+#[cfg(any(unix, test))]
+fn foreground_is_codex(pane_id: &str, info: crate::api::schema::PaneProcessInfo) -> bool {
+    if info.pane_id != pane_id {
+        return false;
+    }
+    let Some(process_group_id) = info.foreground_process_group_id else {
+        return false;
+    };
+    let job = crate::platform::ForegroundJob {
+        process_group_id,
+        processes: info
+            .foreground_processes
+            .into_iter()
+            .map(|process| crate::platform::ForegroundProcess {
+                pid: process.pid,
+                name: process.name,
+                argv0: process.argv0,
+                argv: process.argv,
+                cmdline: process.cmdline,
+            })
+            .collect(),
+    };
+    matches!(
+        crate::detect::identify_agent_in_job(&job),
+        Some((crate::detect::Agent::Codex, _))
+    )
+}
