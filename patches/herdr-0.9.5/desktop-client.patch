+#[test]
+fn mouse_file_menu_invokes_open_and_reveal_without_copy_or_keys() {
+    for (label, action) in [
+        ("打开文件", "cmd_file_0"),
+        ("在 Finder 中显示", "cmd_file_1"),
+    ] {
+        let mut state = file_state("查看 `01_tools/中文 文件.md:12` 后继续");
+        open_file_menu(&mut state, 17);
+        let outcome = click_file_action(&mut state, label);
+        let [ClientShellAction::Endpoint { request, .. }] = &outcome.actions[..] else {
+            panic!("expected one plugin request");
+        };
+        let crate::api::schema::Method::CommandInvoke(params) = &request.method else {
+            panic!("must reuse the existing command API");
+        };
+        assert_eq!(params.command_id, action);
+        assert_eq!(params.pane_id.as_deref(), Some("pane_1"));
+        assert_eq!(params.workspace_id.as_deref(), Some("ws_1"));
+        assert_eq!(params.tab_id.as_deref(), Some("tab_1"));
+        let selection = params.selection.as_ref().unwrap();
+        assert_eq!(selection.pane_id, "pane_1");
+        assert_eq!(selection.anchor.row, 0);
+        assert_eq!((selection.anchor.col, selection.cursor.col), (6, 29));
+        assert_eq!(selection.content_revision, Some(0));
+        assert!(
+            outcome.requests.is_empty(),
+            "mouse action must not type into Codex"
+        );
+    }
+}
