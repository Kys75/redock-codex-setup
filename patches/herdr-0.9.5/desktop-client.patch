@@ -0,0 +1,564 @@
+//! Mouse access to the optional local.file-actions plugin. Presentation only:
+//! command.invoke reads the actual selection and validates its revision on the
+//! existing server. Hover never touches the filesystem, clipboard or process tree.
+use super::link_hover::LinkHoverTarget;
+use super::*;
+use crate::api::schema::{
+    CommandInvokeParams, Method, PaneLinkRegion, PaneSelectionReadParams, PaneTextPoint,
+};
+use std::ops::Range;
+
+#[derive(Debug)]
+pub(super) struct LocalFileMenuTarget {
+    location: LinkHoverTarget,
+    boot_id: String,
+    selections: Vec<(PaneSelectionReadParams, String)>,
+    pub(super) open_command: Option<String>,
+    pub(super) reveal_command: Option<String>,
+}
+
+impl ClientShellState {
+    pub(crate) fn local_file_action_failed(&mut self, error: String) -> bool {
+        self.push_endpoint_notice(
+            ClientEndpointNoticeKind::Rejected,
+            "local_file_failed",
+            "文件未打开",
+            error,
+        )
+    }
+    fn local_file_actions_available(&self) -> bool {
+        self.active_endpoint_id == ClientEndpointId::Local
+            && !self.config.local_file_bindings.is_empty()
+            && self.endpoint_is_online(&self.active_endpoint_id)
+            && self
+                .endpoints
+                .iter()
+                .find(|endpoint| endpoint.endpoint_id == self.active_endpoint_id)
+                .and_then(|endpoint| endpoint.methods.as_ref())
+                .is_some_and(|methods| methods.iter().any(|name| name == "command.invoke"))
+    }
+
+    fn local_file_command_id(&self, command: &str) -> Option<String> {
+        let binding = self
+            .config
+            .local_file_bindings
+            .iter()
+            .find(|binding| binding.command == command)?;
+        let labels = binding.bindings.labels();
+        let mut candidates = self.snapshot.as_ref()?.commands.iter().filter(|candidate| {
+            candidate.action == crate::protocol::ClientShellCommandAction::PluginAction
+                && candidate.description == binding.description
+                && !labels.is_empty()
+                && labels
+                    .iter()
+                    .all(|label| candidate.binding_labels.contains(label))
+        });
+        let candidate = candidates.next()?;
+        candidates
+            .next()
+            .is_none()
+            .then(|| candidate.command_id.clone())
+    }
+
+    pub(super) fn local_file_regions(&self, target: &LinkHoverTarget) -> Vec<PaneLinkRegion> {
+        self.local_file_match(target)
+            .unwrap_or_default()
+            .into_iter()
+            .map(|(region, _)| region)
+            .collect()
+    }
+
+    fn local_file_match(&self, target: &LinkHoverTarget) -> Option<Vec<(PaneLinkRegion, String)>> {
+        if !self.local_file_actions_available() {
+            return None;
+        }
+        let surface = self.pane_surface.as_ref()?;
+        let rect = target.source_rect;
+        if rect.width == 0
+            || rect.width > 4096
+            || u32::from(rect.x) + u32::from(rect.width) > u32::from(surface.frame.width)
+            || u32::from(rect.y) + u32::from(rect.height) > u32::from(surface.frame.height)
+            || target.row >= rect.height
+            || target.col >= rect.width
+        {
+            return None;
+        }
+        match styled_path(&surface.frame, target) {
+            Ok(Some(segments)) => return Some(segments),
+            Err(()) => return None,
+            Ok(None) => {}
+        }
+        let y = usize::from(rect.y) + usize::from(target.row);
+        if y >= usize::from(surface.frame.height)
+            || usize::from(rect.x) + usize::from(rect.width) > usize::from(surface.frame.width)
+        {
+            return None;
+        }
+        let start = y * usize::from(surface.frame.width) + usize::from(rect.x);
+        let cells = surface
+            .frame
+            .cells
+            .get(start..start + usize::from(rect.width))?;
+        let mut text = String::new();
+        let mut bytes = Vec::<Range<usize>>::with_capacity(cells.len());
+        let mut wide_tail = false;
+        for cell in cells {
+            if wide_tail {
+                bytes.push(bytes.last()?.clone());
+                wide_tail = false;
+                continue;
+            }
+            let start = text.len();
+            text.push_str(if cell.symbol.is_empty() {
+                " "
+            } else {
+                &cell.symbol
+            });
+            if text.len() > 8192 {
+                return None;
+            }
+            bytes.push(start..text.len());
+            wide_tail = cell.symbol.width() == 2;
+        }
+        let range = file_range_at(&text, bytes.get(usize::from(target.col))?.start)?;
+        let first = bytes.iter().position(|b| b.end > range.start)?;
+        let last = bytes.iter().rposition(|b| b.start < range.end)?;
+        // A hidden OSC 8 destination can differ from its label. Command selections
+        // carry visible text, so never interpret an alias as an unrelated local file.
+        for cell in &cells[first..=last] {
+            if let Some(id) = cell.hyperlink {
+                let uri = surface.frame.hyperlinks.get(id as usize)?;
+                let visible = &text[range.clone()];
+                if uri != visible && uri.strip_prefix("file://") != Some(visible) {
+                    return None;
+                }
+            }
+        }
+        Some(vec![(
+            PaneLinkRegion {
+                row: target.row,
+                start_col: first as u16,
+                end_col: last as u16,
+            },
+            text[range].to_owned(),
+        )])
+    }
+
+    pub(super) fn local_file_menu_target(&self, x: u16, y: u16) -> Option<LocalFileMenuTarget> {
+        let location = self.pointer_link_target(x, y)?;
+        if !self.link_hover_target_current(&location)
+            || !location.content_revision.is_multiple_of(2)
+        {
+            return None;
+        }
+        let segments = self.local_file_match(&location)?;
+        let open_command = self.local_file_command_id("local.file-actions.open");
+        let reveal_command = self.local_file_command_id("local.file-actions.reveal");
+        if open_command.is_none() && reveal_command.is_none() {
+            return None;
+        }
+        let hit = self
+            .hits
+            .panes
+            .iter()
+            .find(|hit| hit.pane_id == location.pane_id)?;
+        let selections = segments
+            .into_iter()
+            .map(|(region, text)| {
+                let row = crate::selection::absolute_row_for_viewport(region.row, hit.scroll);
+                (
+                    PaneSelectionReadParams {
+                        pane_id: location.pane_id.clone(),
+                        anchor: PaneTextPoint {
+                            row,
+                            col: region.start_col,
+                        },
+                        cursor: PaneTextPoint {
+                            row,
+                            col: region.end_col,
+                        },
+                        content_revision: Some(location.content_revision),
+                    },
+                    text,
+                )
+            })
+            .collect();
+        Some(LocalFileMenuTarget {
+            location,
+            selections,
+            open_command,
+            reveal_command,
+            boot_id: self.snapshot.as_ref()?.boot_id.clone(),
+        })
+    }
+
+    pub(super) fn activate_local_file(
+        &mut self,
+        file: LocalFileMenuTarget,
+        action: ClientContextMenuAction,
+        outcome: &mut ClientShellInput,
+    ) {
+        if self.active_endpoint_id != ClientEndpointId::Local
+            || self
+                .snapshot
+                .as_ref()
+                .is_none_or(|snapshot| snapshot.boot_id != file.boot_id)
+            || !self.link_hover_target_current(&file.location)
+        {
+            outcome.repaint |= self.push_endpoint_notice(
+                ClientEndpointNoticeKind::Rejected,
+                "file_target_changed",
+                "请重新点击文件",
+                "窗格内容或滚动位置已变化，请在当前文件路径上重新右键。",
+            );
+            return;
+        }
+        let command_id = match action {
+            ClientContextMenuAction::OpenLocalFile => file.open_command,
+            ClientContextMenuAction::RevealLocalFile => file.reveal_command,
+            _ => None,
+        };
+        let Some(command_id) = command_id else {
+            return;
+        };
+        let Some(pane) = self.snapshot.as_ref().and_then(|snapshot| {
+            snapshot
+                .panes
+                .iter()
+                .find(|pane| pane.pane_id == file.location.pane_id)
+        }) else {
+            return;
+        };
+        if file.selections.len() > 1 {
+            outcome.actions.push(ClientShellAction::LocalFile(Box::new(
+                crate::client::local_file_actions::LocalFileInvocation {
+                    workspace_id: pane.workspace_id.clone(),
+                    tab_id: pane.tab_id.clone(),
+                    pane_id: pane.pane_id.clone(),
+                    action: if action == ClientContextMenuAction::OpenLocalFile {
+                        "open"
+                    } else {
+                        "reveal"
+                    },
+                    selections: file.selections,
+                },
+            )));
+            return;
+        }
+        self.push_endpoint_method(
+            Method::CommandInvoke(CommandInvokeParams {
+                command_id,
+                workspace_id: Some(pane.workspace_id.clone()),
+                tab_id: Some(pane.tab_id.clone()),
+                pane_id: Some(pane.pane_id.clone()),
+                selection: file
+                    .selections
+                    .into_iter()
+                    .next()
+                    .map(|(selection, _)| selection),
+            }),
+            outcome,
+        );
+    }
+}
+
+type FileSegments = Vec<(PaneLinkRegion, String)>;
+
+/// Codex renders link destinations as distinct style runs, even when a table
+/// wraps them before the terminal's right edge. Only join a complete, bounded
+/// parenthesized run; table padding and other columns never enter the path.
+fn styled_path(frame: &FrameData, target: &LinkHoverTarget) -> Result<Option<FileSegments>, ()> {
+    let rect = target.source_rect;
+    let row_cells = |row: u16| {
+        let start = usize::from(rect.y + row) * usize::from(frame.width) + usize::from(rect.x);
+        frame.cells.get(start..start + usize::from(rect.width))
+    };
+    let clicked_cells = row_cells(target.row).ok_or(())?;
+    let mut clicked_col = usize::from(target.col);
+    if clicked_col > 0 && clicked_cells[clicked_col - 1].symbol.width() == 2 {
+        clicked_col -= 1;
+    }
+    let style = &clicked_cells[clicked_col];
+    let same_style = |cell: &crate::protocol::CellData| {
+        cell.fg == style.fg && cell.bg == style.bg && cell.modifier == style.modifier
+    };
+    let mut claimed = false;
+    let mut found = None;
+    // At most 8 candidate starts × 8 rows, only on pointer movement; no I/O.
+    for start_row in target.row.saturating_sub(7)..=target.row {
+        let mut segments = Vec::new();
+        let mut closing = None;
+        let mut includes_pointer = false;
+        let mut bytes = 0;
+        for row in start_row..rect.height.min(start_row.saturating_add(8)) {
+            let cells = row_cells(row).ok_or(())?;
+            let mut runs = Vec::new();
+            let mut col = 0;
+            while col < cells.len() {
+                if !same_style(&cells[col]) {
+                    col += 1;
+                    continue;
+                }
+                let first = col;
+                col += cells[col].symbol.width().max(1);
+                while col < cells.len() && same_style(&cells[col]) {
+                    col += cells[col].symbol.width().max(1);
+                }
+                let end = col.min(cells.len());
+                let mut text = String::new();
+                let mut i = first;
+                while i < end {
+                    text.push_str(&cells[i].symbol);
+                    i += cells[i].symbol.width().max(1);
+                }
+                if !text.trim().is_empty() {
+                    runs.push((first, end, text));
+                }
+            }
+            if row == target.row {
+                claimed |= runs.iter().any(|(first, end, text)| {
+                    *first <= clicked_col
+                        && clicked_col < *end
+                        && looks_like_path(text)
+                        && (style.fg != 0
+                            && (*first > 0 || *end < cells.len())
+                            && !(*first > 0
+                                && matches!(cells[first - 1].symbol.as_str(), "`" | "\"" | "'"))
+                            || *first > 0 && matches!(cells[first - 1].symbol.as_str(), "(" | "（")
+                            || cells
+                                .get(*end)
+                                .is_some_and(|cell| matches!(cell.symbol.as_str(), ")" | "）")))
+                });
+            }
+            // Multiple same-style spans could belong to adjacent table columns.
+            let [(first, end, text)] = runs.as_slice() else {
+                break;
+            };
+            let before = if *first == 0 {
+                None
+            } else {
+                Some(cells[first - 1].symbol.as_str())
+            };
+            let after = cells.get(*end).map(|cell| cell.symbol.as_str());
+            if row == start_row {
+                closing = match before {
+                    Some("(") => Some(")"),
+                    Some("（") => Some("）"),
+                    _ => None,
+                };
+                if closing.is_none() {
+                    break;
+                }
+            } else if cells[..*first]
+                .iter()
+                .any(|cell| !cell.symbol.trim().is_empty())
+            {
+                break;
+            }
+            includes_pointer |= row == target.row && *first <= clicked_col && clicked_col < *end;
+            claimed |= includes_pointer;
+            if cells[*first..*end]
+                .iter()
+                .any(|cell| cell.hyperlink.is_some())
+            {
+                break;
+            }
+            bytes += text.len();
+            if bytes > 8192 {
+                break;
+            }
+            segments.push((
+                PaneLinkRegion {
+                    row,
+                    start_col: *first as u16,
+                    end_col: (end - 1) as u16,
+                },
+                text.clone(),
+            ));
+            if after == closing {
+                let path: String = segments.iter().map(|(_, text)| text.as_str()).collect();
+                if includes_pointer && looks_like_path(&path) {
+                    if found.is_some() {
+                        return Err(());
+                    }
+                    found = Some(segments);
+                }
+                break;
+            }
+            // Continuations may end before padded table columns, but not in prose.
+            if after.is_some_and(|s| !s.trim().is_empty()) {
+                break;
+            }
+        }
+    }
+    if found.is_none() && claimed {
+        Err(())
+    } else {
+        Ok(found)
+    }
+}
+
+fn looks_like_path(text: &str) -> bool {
+    if text.is_empty()
+        || text.chars().any(char::is_control)
+        || text.contains("://") && !text.starts_with("file://")
+    {
+        return false;
+    }
+    if text.starts_with("file://") || text.starts_with('/') || text.contains('/') {
+        return text != "/";
+    }
+    let filename = text.split([':', '#']).next().unwrap_or(text);
+    filename.rsplit_once('.').is_some_and(|(stem, ext)| {
+        !stem.is_empty()
+            && !ext.is_empty()
+            && ext.len() <= 12
+            && ext.chars().all(char::is_alphanumeric)
+    })
+}
+
+fn file_range_at(text: &str, byte: usize) -> Option<Range<usize>> {
+    if byte >= text.len() {
+        return None;
+    }
+    // Quoting disambiguates whitespace inside filenames. Bound scanning to this row.
+    let mut quote = None;
+    for (index, ch) in text.char_indices() {
+        match quote {
+            Some((opening, start)) if ch == opening => {
+                if start <= byte && byte < index {
+                    return looks_like_path(&text[start..index]).then_some(start..index);
+                }
+                quote = None;
+            }
+            None if matches!(ch, '`' | '\'' | '"') => quote = Some((ch, index + ch.len_utf8())),
+            _ => {}
+        }
+    }
+    // Rendered Markdown links use outer parentheses; filenames may contain (1).
+    let mut openings = Vec::new();
+    let mut enclosed = None;
+    for (index, ch) in text.char_indices() {
+        if matches!(ch, '(' | '（') {
+            let container = index == 0
+                || text[..index].chars().next_back().is_some_and(|before| {
+                    before.is_whitespace() || matches!(before, ']' | ':' | '：')
+                });
+            openings.push((index + ch.len_utf8(), ch, container));
+        }
+        if matches!(ch, ')' | '）') {
+            if let Some((start, opening, container)) = openings.pop() {
+                if container
+                    && (opening == '(' && ch == ')' || opening == '（' && ch == '）')
+                    && start <= byte
+                    && byte < index
+                    && looks_like_path(&text[start..index])
+                {
+                    enclosed = Some(start..index);
+                }
+            }
+        }
+    }
+    if enclosed.is_some() {
+        return enclosed;
+    }
+    let boundary = |ch: char| {
+        ch.is_whitespace()
+            || matches!(
+                ch,
+                '`' | '\''
+                    | '"'
+                    | '<'
+                    | '>'
+                    | '['
+                    | ']'
+                    | '('
+                    | ')'
+                    | '|'
+                    | ','
+                    | ';'
+                    | '，'
+                    | '。'
+                    | '；'
+                    | '：'
+                    | '“'
+                    | '”'
+                    | '（'
+                    | '）'
+            )
+    };
+    let mut start = 0;
+    let mut inner_parentheses = 0;
+    for (index, ch) in text
+        .char_indices()
+        .chain(std::iter::once((text.len(), ' ')))
+    {
+        if ch == '(' && start < index {
+            inner_parentheses += 1;
+            continue;
+        }
+        if ch == ')' && inner_parentheses > 0 {
+            inner_parentheses -= 1;
+            continue;
+        }
+        if boundary(ch) {
+            if start <= byte && byte < index {
+                let candidate = text[start..index].trim_end_matches(['.', ':']);
+                let end = start + candidate.len();
+                return (byte < end && looks_like_path(candidate)).then_some(start..end);
+            }
+            start = index + ch.len_utf8();
+            inner_parentheses = 0;
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn local_file_tokens_handle_quotes_markdown_line_numbers_and_web_exclusion() {
+        for (text, token, expected) in [
+            ("read docs/说明.md:12 now", "说明", Some("docs/说明.md:12")),
+            (
+                "read `docs/my file.md` now",
+                "file",
+                Some("docs/my file.md"),
+            ),
+            ("[title](docs/a.md#L2)", "a.md", Some("docs/a.md#L2")),
+            (
+                "布局图 (0701 项目/资料/Layout-APPROVED(1).pdf)，说明",
+                "0701",
+                Some("0701 项目/资料/Layout-APPROVED(1).pdf"),
+            ),
+            ("see README.md.", "README", Some("README.md")),
+            (
+                "read \"docs/report(v1.0).pdf\" now",
+                "v1.0",
+                Some("docs/report(v1.0).pdf"),
+            ),
+            (
+                "read docs/report(v1.0).pdf now",
+                "v1.0",
+                Some("docs/report(v1.0).pdf"),
+            ),
+            (
+                "read (docs/report(v1.0).pdf) now",
+                "v1.0",
+                Some("docs/report(v1.0).pdf"),
+            ),
+            (
+                "file:///tmp/a%20b.txt",
+                "a%20",
+                Some("file:///tmp/a%20b.txt"),
+            ),
+            ("https://example.com/a.md", "a.md", None),
+            ("just words", "words", None),
+        ] {
+            let found = file_range_at(text, text.find(token).unwrap()).map(|range| &text[range]);
+            assert_eq!(found, expected, "{text}");
+        }
+    }
+}
