+            ("vim", false),
+            ("claude", false),
+        ] {
+            let info: crate::api::schema::PaneProcessInfo = serde_json::from_value(serde_json::json!({
+                "pane_id": "w1:p1", "foreground_process_group_id": 42,
+                "foreground_processes": [{"pid": 42, "name": name, "argv0": name, "argv": [name]}]
